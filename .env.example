# Variáveis locais do repositório (copie para .env e ajuste; .env é ignorado pelo Git).
# Caminhos do Windows; use aspas se houver espaços. Versão de 07/11/2026 (Fase 5.2).

# Raiz da pasta operacional CGOV no Google Drive (usada por scripts/reorganizar_cgov.py e
# scripts/gerar_indices.py)
CGOV_RAIZ="C:\Users\<usuario>\My Drive\<pasta>\CGOV"

# Alvos das junções criadas por scripts/link_acervo.py (Fase 5.1–5.2). Se faltarem, o script usa
# CGOV_RAIZ + subpasta. Use caminhos completos: scripts/gerar_indices.py não expande %VARIAVEIS%.
CGOV_PROCESSOS="C:\Users\<usuario>\My Drive\<pasta>\CGOV\01_processos"
CGOV_NORMATIVOS="C:\Users\<usuario>\My Drive\<pasta>\CGOV\03_normativos"
CGOV_ESCRITORIO="C:\Users\<usuario>\My Drive\<pasta>\CGOV\90_escritorio-virtual"

# Obsoletas desde 06/11/2026 (estrutura anterior à Fase 4; modelo antigo em archive/env.example_ate-2026-11-06):
# CGOV_NORMATIVE_SOURCES, CGOV_ACERVO_DRIVE, CGOV_ANALYSES, CGOV_REFERENCIA
