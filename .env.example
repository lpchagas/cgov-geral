# Variáveis locais do repositório (copie para .env e ajuste; .env é ignorado pelo Git).
# Caminhos do Windows; use aspas se houver espaços. Versão de 06/11/2026 (depois da Fase 4).

# Raiz da pasta operacional CGOV no Google Drive (usada por scripts/reorganizar_cgov.py e
# scripts/gerar_indices.py)
CGOV_RAIZ="C:\Users\<usuario>\My Drive\<pasta>\CGOV"

# ⏳ Fase 5.1–5.2 do plano de implantação: junções novas do repositório para a pasta CGOV
# CGOV_PROCESSOS="C:\Users\<usuario>\My Drive\<pasta>\CGOV\01_processos"            -> local\processos
# CGOV_NORMATIVOS="C:\Users\<usuario>\My Drive\<pasta>\CGOV\03_normativos"          -> local\normativos
# CGOV_ESCRITORIO="C:\Users\<usuario>\My Drive\<pasta>\CGOV\90_escritorio-virtual"  -> local\escritorio

# Obsoletas desde 06/11/2026 (estrutura anterior à Fase 4; modelo antigo em archive/env.example_ate-2026-11-06):
